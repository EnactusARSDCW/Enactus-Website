---
import ImagePlaceholder from './ImagePlaceholder.astro';
import { getStory } from '../data/stories';

interface Props {
  slug: string;
  /** Featured stories get a taller tile and larger headline. */
  featured?: boolean;
}

const { slug, featured = false } = Astro.props;
const story = getStory(slug);
if (!story) throw new Error(`Unknown story slug: ${slug}`);

const dateLabel = story.date
  ? new Date(story.date + 'T00:00:00').toLocaleDateString('en-IN', {
      year: 'numeric',
      month: 'long',
      day: 'numeric',
    })
  : 'Date to be confirmed';
---

<article class:list={['tile', 'tile--photo', 'story-card', { 'story-card--featured': featured }]}>
  <div class="story-card__media">
    <ImagePlaceholder
      image={story.image}
      alt={story.imageAlt}
      label="Story photograph to be added"
      variant="fill"
    />
    <span class="tile__scrim" aria-hidden="true"></span>
  </div>

  <div class="tile__panel tile__panel--frost story-card__panel">
    <p class="tile__eyebrow story-card__eyebrow">
      <span>{story.category}</span>
      <span class="story-card__sep" aria-hidden="true">·</span>
      <time datetime={story.date ?? undefined}>{dateLabel}</time>
    </p>
    <h3 class:list={['tile__title', featured && 'tile__title--lg']}>{story.title}</h3>
    <p class="tile__desc tile__desc--clamp">{story.excerpt}</p>
    <span class="tile__cta" aria-hidden="true">Read the story <span aria-hidden="true">→</span></span>
  </div>

  <a class="tile__cover" href={`/stories/${story.slug}`} aria-label={`${story.title} — ${story.category}. Read the story.`}></a>
</article>

<style>
  .story-card {
    aspect-ratio: 5 / 4;
    min-height: 21rem;
  }

  .story-card--featured {
    aspect-ratio: 4 / 3;
    min-height: 26rem;
  }

  .story-card__media {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .story-card__panel {
    position: absolute;
    z-index: 2;
    inset: auto 0.7rem 0.7rem;
  }

  .story-card__eyebrow {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    flex-wrap: wrap;
  }

  .story-card__eyebrow time {
    letter-spacing: 0.06em;
    color: var(--ink-2);
    font-weight: 500;
  }

  .story-card__sep {
    color: var(--border);
  }

  .story-card .tile__title {
    font-size: 1.12rem;
  }

  .story-card--featured .tile__title {
    font-size: clamp(1.3rem, 2vw, 1.55rem);
  }
</style>
