---
import ImagePlaceholder from './ImagePlaceholder.astro';
import { getProduct } from '../data/products';
import { getProject } from '../data/projects';

interface Props {
  slug: string;
}

const { slug } = Astro.props;
const product = getProduct(slug);
if (!product) throw new Error(`Unknown product slug: ${slug}`);

const project = getProject(product.projectSlug);
const projectName = project?.name ?? 'our projects';
const lead = product.description?.[0] ?? '';
const price = product.price ?? 'Price on enquiry';
const availability = product.availability ?? 'Enquire for availability';
---

<article class="tile tile--glass product-card">
  <div class="product-card__body">
    <p class="tile__eyebrow">From {projectName}</p>
    <h3 class="tile__title">{product.name}</h3>
    {lead && <p class="tile__desc tile__desc--clamp">{lead}</p>}
    <p class="tile__price">{price}</p>
  </div>

  <div class="product-card__media">
    <ImagePlaceholder
      image={product.image}
      alt={product.imageAlt}
      label="Product photograph to be added"
      variant="fill"
    />
    <span class="tile__chip product-card__chip"><span>{availability}</span></span>
  </div>

  <a class="tile__cover" href={`/shop/${product.slug}`} aria-label={`${product.name} — ${price}. View the product.`}></a>
</article>

<style>
  .product-card__body {
    padding: var(--space-5) var(--space-5) var(--space-4);
  }

  /* Image fills the base of the tile so every card in a row lines up. */
  .product-card__media {
    position: relative;
    flex: 1 1 auto;
    min-height: 9.5rem;
    aspect-ratio: 4 / 3;
    margin-top: auto;
  }

  .product-card__chip {
    position: absolute;
    z-index: 2;
    left: 0.7rem;
    bottom: 0.7rem;
    max-width: calc(100% - 1.4rem);
  }
</style>
