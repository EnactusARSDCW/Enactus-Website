---
import ImagePlaceholder from './ImagePlaceholder.astro';
import { getProduct } from '../data/products';
import { getProject } from '../data/projects';

interface Props {
  slug: string;
}

const { slug } = Astro.props;
const product = getProduct(slug);
if (!product) throw new Error(`Unknown product slug: ${slug}`);
const project = getProduct ? getProject(product.projectSlug) : undefined;
const projectName = project ? project.name.replace(/^Project\s+/, '') : 'our projects';
---

<article class="product-card">
  <a href={`/shop/${product.slug}`} class="product-card__media-link">
    <ImagePlaceholder
      image={product.image}
      alt={product.imageAlt}
      label="Product photograph to be added"
      ratio="square"
      class="product-card__media"
    />
  </a>
  <div class="product-card__body">
    <p class="product-card__variant">{product.availability ?? 'Enquire for availability'}</p>
    <h3 class="product-card__name">
      <a href={`/shop/${product.slug}`}>{product.name}</a>
    </h3>
    <p class="product-card__price">{product.price ?? 'Price on enquiry'}</p>
    <p class="product-card__from">Supporting Project {projectName}</p>
  </div>
</article>

<style>
  .product-card {
    display: flex;
    flex-direction: column;
    background: #fff;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    transition: box-shadow 0.25s ease, transform 0.25s ease;
  }

  .product-card:hover {
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
  }

  .product-card__media {
    border: 0;
    border-bottom: 1px solid var(--border);
    border-radius: 0;
  }

  .product-card__body {
    padding: var(--space-4) var(--space-5) var(--space-5);
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .product-card__variant {
    font-size: 0.78rem;
    color: var(--ink-2);
    letter-spacing: 0.04em;
    margin: 0;
  }

  .product-card__name {
    font-size: 1.1rem;
    margin: 0.1rem 0 0;
  }

  .product-card__name a {
    color: var(--ink);
  }

  .product-card__name a:hover {
    color: var(--accent-deep);
  }

  .product-card__price {
    font-family: var(--font-heading);
    font-weight: 600;
    color: var(--accent-deep);
    margin: 0.35rem 0 0;
    font-size: 0.98rem;
  }

  .product-card__from {
    margin: 0.9rem 0 0;
    padding-top: 0.75rem;
    border-top: 1px solid var(--border);
    color: var(--ink-2);
    font-size: 0.85rem;
  }
</style>
