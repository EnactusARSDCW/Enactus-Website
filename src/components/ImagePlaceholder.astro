---
// Reusable image-slot component. Renders a real photograph when one exists,
// otherwise a calm, labelled placeholder — never a fabricated/AI image.
//
// variant="framed" (default) — a bordered media box for editorial layouts.
// variant="fill"             — edge-to-edge media that fills its parent tile,
//                              so photographs can sit under glass panels.
interface Props {
  image?: string | null;
  alt: string;
  label?: string;
  ratio?: 'wide' | 'tall' | 'square' | 'photo';
  variant?: 'framed' | 'fill';
  class?: string;
  loading?: 'eager' | 'lazy';
}

const {
  image = null,
  alt,
  label = 'Project photograph to be added',
  ratio = 'photo',
  variant = 'framed',
  class: className = '',
  loading = 'lazy',
} = Astro.props;

const isFill = variant === 'fill';

const ratioCss = isFill
  ? undefined
  : ratio === 'wide'
    ? 'aspect-ratio: 16 / 9;'
    : ratio === 'tall'
      ? 'aspect-ratio: 4 / 5;'
      : ratio === 'square'
        ? 'aspect-ratio: 1 / 1;'
        : 'aspect-ratio: 3 / 2;';
---

<figure
  class:list={['media-slot', isFill && 'media-slot--fill', className]}
  style={ratioCss}
  aria-label={image ? undefined : label}
>
  {
    image ? (
      <img src={image} alt={alt} loading={loading} decoding="async" />
    ) : (
      <div class="media-slot__placeholder" role="img" aria-label={alt}>
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
          <rect x="3" y="5" width="18" height="14" rx="2" />
          <circle cx="8.5" cy="10" r="1.6" />
          <path d="m3 17 5.2-5.2a1 1 0 0 1 1.4 0L15 17" />
          <path d="m13.5 14.5 2-2a1 1 0 0 1 1.4 0L21 16.5" />
        </svg>
        <span>{label}</span>
      </div>
    )
  }
  {Astro.slots.default && image ? <figcaption class="media-slot__caption sr-only"><slot /></figcaption> : null}
</figure>

<style>
  figure.media-slot {
    margin: 0;
    width: 100%;
    overflow: hidden;
    background: var(--bg-alt);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
  }

  figure.media-slot img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .media-slot__placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    color: var(--ink-2);
    background: var(--tile-pending);
    text-align: center;
    padding: 1rem;
  }

  .media-slot__placeholder span {
    font-size: 0.82rem;
    max-width: 22ch;
    line-height: 1.45;
  }

  /* ---------- Fill variant: media becomes the tile surface ---------- */
  figure.media-slot--fill {
    height: 100%;
    min-height: 100%;
    border: 0;
    border-radius: 0;
    background: var(--tile-pending);
  }

  .media-slot--fill .media-slot__placeholder {
    align-items: flex-start;
    justify-content: flex-start;
    gap: 0.5rem;
    padding: 1.15rem 1.25rem;
    text-align: left;
    color: rgba(32, 32, 32, 0.55);
    background: transparent;
  }

  .media-slot--fill .media-slot__placeholder svg {
    opacity: 0.65;
  }

  .media-slot--fill .media-slot__placeholder span {
    font-family: var(--font-heading);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    max-width: 16ch;
    line-height: 1.4;
  }
</style>
