---
interface Crumb {
  label: string;
  url?: string;
}

interface Props {
  items: Crumb[];
  onDark?: boolean;
}

const { items, onDark = false } = Astro.props;
const trail = [{ label: 'Home', url: '/' }, ...items];
---

<nav class:list={['breadcrumbs', { 'breadcrumbs--dark': onDark }]} aria-label="Breadcrumb">
  <ol>
    {
      trail.map((c, i) => {
        const last = i === trail.length - 1;
        return (
          <li>
            {c.url && !last ? (
              <a href={c.url}>{c.label}</a>
            ) : (
              <span aria-current="page">{c.label}</span>
            )}
            {!last && <span class="sep" aria-hidden="true">→</span>}
          </li>
        );
      })
    }
  </ol>
</nav>

<style>
  .breadcrumbs ol {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.45rem;
    list-style: none;
    margin: 0 0 var(--space-4);
    padding: 0;
    font-size: 0.82rem;
  }

  .breadcrumbs li {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
  }

  .breadcrumbs a,
  .breadcrumbs span[aria-current] {
    font-weight: 500;
  }

  .breadcrumbs a {
    color: var(--ink-2);
  }

  .breadcrumbs a:hover {
    color: var(--accent-deep);
  }

  .breadcrumbs span[aria-current] {
    color: var(--ink);
  }

  .sep {
    color: var(--border);
    font-size: 0.75rem;
  }

  .breadcrumbs--dark a,
  .breadcrumbs--dark span[aria-current] {
    color: rgba(255, 255, 255, 0.65);
  }

  .breadcrumbs--dark a:hover {
    color: var(--accent);
  }

  .breadcrumbs--dark span[aria-current] {
    color: #fff;
  }
</style>
