---
import { site, nav } from '../data/site';

const year = new Date().getFullYear();
const quickLinks = [
  { label: 'About Us', url: '/about' },
  { label: 'Projects', url: '/projects' },
  { label: 'Shop', url: '/shop' },
  { label: 'Stories', url: '/stories' },
  { label: 'Our Team', url: '/team' },
  { label: 'Gallery', url: '/gallery' },
];

const supportLinks = [
  { label: 'Join Us', url: '/join-us' },
  { label: 'Partners', url: '/partners' },
  { label: 'Contact Us', url: '/contact' },
  { label: 'Privacy Policy', url: '/privacy-policy' },
  { label: 'Terms of Use', url: '/terms' },
];
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-brand">
      <a href="/" class="footer-logo" aria-label={`${site.name} — home`}>
        <span class="footer-logo__mark" aria-hidden="true">E</span>
        <span>Enactus <em>ARSD</em></span>
      </a>
      <p class="footer-desc">{site.description}</p>
      <p class="footer-inst">{site.institution}</p>
    </div>

    <nav class="footer-col" aria-label="Site">
      <h3>Explore</h3>
      <ul>
        {quickLinks.map((l) => <li><a href={l.url}>{l.label}</a></li>)}
      </ul>
    </nav>

    <nav class="footer-col" aria-label="Support">
      <h3>Get involved</h3>
      <ul>
        {supportLinks.map((l) => <li><a href={l.url}>{l.label}</a></li>)}
      </ul>
    </nav>

    <div class="footer-col footer-col--contact">
      <h3>Contact</h3>
      <ul>
        <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
        {
          site.social.map((s) => (
            <li>
              <a href={s.url} rel="me noopener" target="_blank">
                {s.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  <div class="container footer-legal">
    <p>
      © {year} {site.name}, {site.institution}. Part of the global Enactus network.
      {nav.length ? '' : ''}
    </p>
    <p class="footer-legal__links">
      <a href="/privacy-policy">Privacy Policy</a>
      <span aria-hidden="true">·</span>
      <a href="/terms">Terms</a>
    </p>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: auto;
    background: var(--dark);
    color: rgba(255, 255, 255, 0.8);
    padding-top: var(--space-8);
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 2.2fr 1fr 1fr 1.2fr;
    gap: var(--space-6);
    padding-bottom: var(--space-7);
  }

  .footer-logo {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 1.15rem;
    color: #fff;
  }

  .footer-logo:hover {
    color: #fff;
  }

  .footer-logo__mark {
    width: 34px;
    height: 34px;
    display: grid;
    place-items: center;
    background: rgba(255, 255, 255, 0.08);
    color: var(--accent);
    border-radius: 9px;
    font-size: 1rem;
  }

  .footer-logo em {
    font-style: normal;
    color: var(--accent);
  }

  .footer-desc {
    margin-top: var(--space-3);
    font-size: 0.92rem;
    line-height: 1.7;
    max-width: 34rem;
    color: rgba(255, 255, 255, 0.65);
  }

  .footer-inst {
    font-size: 0.85rem;
    color: rgba(255, 255, 255, 0.5);
  }

  .footer-col h3 {
    font-size: 0.8rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.55);
    margin-bottom: var(--space-3);
    font-weight: 600;
  }

  .footer-col ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.55rem;
  }

  .footer-col a {
    color: rgba(255, 255, 255, 0.8);
    font-size: 0.92rem;
  }

  .footer-col a:hover {
    color: var(--accent);
  }

  .footer-legal {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    justify-content: space-between;
    align-items: center;
    border-top: 1px solid rgba(255, 255, 255, 0.12);
    padding-top: var(--space-4);
    padding-bottom: var(--space-5);
    font-size: 0.82rem;
    color: rgba(255, 255, 255, 0.55);
  }

  .footer-legal p {
    margin: 0;
  }

  .footer-legal__links {
    display: inline-flex;
    gap: 0.6rem;
    align-items: center;
  }

  .footer-legal__links a {
    color: rgba(255, 255, 255, 0.75);
  }

  .footer-legal__links a:hover {
    color: var(--accent);
  }

  @media (max-width: 900px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 560px) {
    .footer-grid {
      grid-template-columns: 1fr;
      gap: var(--space-5);
    }
  }
</style>
