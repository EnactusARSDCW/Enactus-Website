---
interface Props {
  title?: string;
  body?: string;
  primaryLabel?: string;
  primaryUrl?: string;
  secondaryLabel?: string;
  secondaryUrl?: string;
}

const {
  title = 'Get involved with Enactus ARSD',
  body = 'Whether you want to join the team as a student, volunteer alongside a project, or partner with us as an organisation — there is a place for you here.',
  primaryLabel = 'Join Us',
  primaryUrl = '/join-us',
  secondaryLabel = 'Contact the team',
  secondaryUrl = '/contact',
} = Astro.props;
---

<section class="involve-band">
  <div class="container involve-inner">
    <div>
      <h2>{title}</h2>
      <p>{body}</p>
    </div>
    <div class="involve-actions">
      <a class="btn btn--accent" href={primaryUrl}>{primaryLabel}</a>
      <a class="btn btn--ghost-on-dark" href={secondaryUrl}>{secondaryLabel}</a>
    </div>
  </div>
</section>

<style>
  .involve-band {
    background: var(--dark);
    color: rgba(255, 255, 255, 0.85);
    padding-block: clamp(3rem, 7vw, 5rem);
  }

  .involve-band h2 {
    color: #fff;
    margin-bottom: var(--space-3);
  }

  .involve-band p {
    margin: 0;
    max-width: 40rem;
    color: rgba(255, 255, 255, 0.7);
  }

  .involve-inner {
    display: grid;
    gap: var(--space-5);
    align-items: center;
  }

  @media (min-width: 860px) {
    .involve-inner {
      grid-template-columns: 1.4fr 1fr;
    }

    .involve-actions {
      justify-self: end;
      display: flex;
      gap: var(--space-3);
      flex-wrap: wrap;
    }
  }
</style>
