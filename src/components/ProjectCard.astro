---
import ImagePlaceholder from './ImagePlaceholder.astro';
import { getProject } from '../data/projects';

interface Props {
  slug: string;
  /**
   * editorial — photograph tile with a frosted panel floating over it.
   * featured  — wider split tile: photograph bleeding into a glass surface.
   */
  variant?: 'editorial' | 'featured';
}

const { slug, variant = 'editorial' } = Astro.props;
const project = getProject(slug);
if (!project) throw new Error(`Unknown project slug: ${slug}`);

const isFeatured = variant === 'featured';
const linkLabel = `${project.name} — ${project.category}. Explore the project.`;
---

<article class:list={['tile', isFeatured ? 'tile--glass' : 'tile--photo', 'project-card', `project-card--${variant}`]}>
  <div class="project-card__media">
    <ImagePlaceholder
      image={project.image}
      alt={project.imageAlt}
      label="Project photograph to be added"
      variant="fill"
    />
    {!isFeatured && <span class="tile__scrim" aria-hidden="true"></span>}
  </div>

  <div
    class:list={[
      'tile__panel',
      'project-card__panel',
      isFeatured ? 'project-card__panel--solid' : 'tile__panel--frost project-card__panel--float',
    ]}
  >
    <p class="tile__eyebrow">{project.category}</p>
    <h3 class:list={['tile__title', isFeatured && 'tile__title--lg']}>{project.name}</h3>
    <p class="tile__desc tile__desc--clamp">{project.summary}</p>
    <span class="tile__cta" aria-hidden="true">Explore the project <span aria-hidden="true">→</span></span>
  </div>

  <a class="tile__cover" href={`/projects/${project.slug}`} aria-label={linkLabel}></a>
</article>

<style>
  /* ---------- Editorial: full-bleed photograph, frosted panel over it ---------- */
  .project-card--editorial {
    aspect-ratio: 4 / 5;
    min-height: 24rem;
  }

  .project-card__media {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .project-card__panel--float {
    position: absolute;
    z-index: 2;
    inset: auto 0.7rem 0.7rem;
  }

  /* ---------- Featured: photograph and glass surface share one tile ---------- */
  .project-card--featured {
    display: grid;
    min-height: 0;
  }

  .project-card--featured .project-card__media {
    position: relative;
    inset: auto;
    min-height: 16rem;
    aspect-ratio: 16 / 11;
  }

  .project-card--featured .project-card__media::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background: linear-gradient(90deg, rgba(255, 255, 255, 0) 72%, rgba(255, 255, 255, 0.92) 100%);
  }

  .project-card__panel--solid {
    position: relative;
    z-index: 2;
    background: transparent;
    border: 0;
    box-shadow: none;
    padding: clamp(1.5rem, 3vw, 2.6rem);
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  @media (min-width: 860px) {
    .project-card--featured {
      grid-template-columns: 1.08fr 0.92fr;
    }

    .project-card--featured .project-card__media {
      aspect-ratio: auto;
      height: 100%;
      min-height: 24rem;
    }
  }
</style>
