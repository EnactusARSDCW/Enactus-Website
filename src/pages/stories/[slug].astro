---
import BaseLayout from '../../components/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ImagePlaceholder from '../../components/ImagePlaceholder.astro';
import StoryCard from '../../components/StoryCard.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import { stories, getStory } from '../../data/stories';

export function getStaticPaths() {
  return stories.map((s) => ({ params: { slug: s.slug }, props: { story: s } }));
}

const { story }: { story: Exclude<ReturnType<typeof getStory>, undefined> } = Astro.props;
const dateLabel = story.date
  ? new Date(story.date + 'T00:00:00').toLocaleDateString('en-IN', { year: 'numeric', month: 'long', day: 'numeric' })
  : null;
const related = stories.filter((s) => s.slug !== story.slug && story.relatedProjects?.some((p) => s.relatedProjects?.includes(p))).slice(0, 2);
const fallbackRelated = related.length > 0 ? related : stories.filter((s) => s.slug !== story.slug).slice(0, 2);
---

<BaseLayout title={story.title} description={story.excerpt}>
  <div class="hero container">
    <Breadcrumbs items={[{ label: 'Stories', url: '/stories' }, { label: story.title }]} />
    <p class="kicker">{story.category}</p>
    <h1>{story.title}</h1>
    <p class="hero-meta">
      {dateLabel && <time datetime={story.date ?? undefined}>{dateLabel}</time>}
      {story.author && <span>· By {story.author}</span>}
    </p>
  </div>

  <section class="section section--flush">
    <div class="container">
      <ImagePlaceholder
        image={story.image}
        alt={story.imageAlt}
        label="Story photograph to be added"
        ratio="wide"
        loading="eager"
      />
    </div>
  </section>

  <article class="section">
    <div class="container-narrow article-body">
      {
        story.body.map((block) => {
          if (block.type === 'h') return <h2>{block.text}</h2>;
          if (block.type === 'list')
            return (
              <ul>
                {block.items?.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            );
          return <p>{block.text}</p>;
        })
      }
      {
        story.sourceUrl && (
          <p class="source">
            This story is based on the chapter's own published update —{' '}
            <a class="text-link" href={story.sourceUrl} rel="noopener" target="_blank">
              read the original ↗
            </a>
          </p>
        )
      }
      <a class="back-link btn btn--ghost" href="/stories">← Back to Stories</a>
    </div>
  </article>

  <section class="section section--alt">
    <div class="container">
      <SectionHeading kicker="Keep reading" title="Related stories" />
      <div class="related-grid">
        {fallbackRelated.map((s) => <StoryCard slug={s.slug} />)}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    padding-block: clamp(2.5rem, 6vw, 4rem) clamp(2rem, 4vw, 3rem);
  }

  .hero h1 {
    max-width: 24ch;
  }

  .hero-meta {
    color: var(--ink-2);
    font-size: 0.92rem;
    margin: 0;
  }

  .section--flush {
    padding-top: 0;
  }

  .article-body {
    font-size: 1.03rem;
    line-height: 1.8;
    color: var(--ink-2);
  }

  .article-body p {
    margin-bottom: var(--space-4);
  }

  .article-body h2 {
    color: var(--ink);
    margin-top: var(--space-6);
    font-size: 1.35rem;
  }

  .article-body ul {
    margin: 0 0 var(--space-4);
    padding-left: 1.3rem;
    display: grid;
    gap: 0.5rem;
  }

  .article-body li::marker {
    color: var(--accent-deep);
  }

  .source {
    border-top: 1px solid var(--border);
    padding-top: var(--space-4);
    font-size: 0.88rem;
    margin-top: var(--space-6);
  }

  .back-link {
    margin-top: var(--space-6);
  }

  .related-grid {
    display: grid;
    gap: var(--space-5);
    grid-template-columns: 1fr 1fr;
  }

  @media (max-width: 880px) {
    .related-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
