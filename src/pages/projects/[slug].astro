---
import BaseLayout from '../../components/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ImagePlaceholder from '../../components/ImagePlaceholder.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import GetInvolvedCTA from '../../components/GetInvolvedCTA.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import StoryCard from '../../components/StoryCard.astro';
import { projects, getProject } from '../../data/projects';
import { getStory } from '../../data/stories';

export function getStaticPaths() {
  return projects.map((p) => ({ params: { slug: p.slug }, props: { project: p } }));
}

const { project }: { project: Exclude<ReturnType<typeof getProject>, undefined> } = Astro.props;
const relatedStories = (project.relatedStories ?? []).map((s) => getStory(s)).filter(Boolean);
const relatedProjects = (project.relatedProjects ?? []).map((s) => getProject(s)).filter(Boolean);
---

<BaseLayout title={project.name} description={project.summary}>
  <div class="hero container">
    <Breadcrumbs items={[{ label: 'Projects', url: '/projects' }, { label: project.name }]} />
    <p class="kicker">{project.category}</p>
    <h1>{project.name}</h1>
    <p class="lede">{project.tagline}</p>
  </div>

  <section class="section--flush">
    <div class="container">
      <ImagePlaceholder
        image={project.image}
        alt={project.imageAlt}
        label="Project photograph to be added"
        ratio="wide"
        loading="eager"
      />
    </div>
  </section>

  <!-- Problem + approach -->
  <section class="section">
    <div class="container two-col">
      <article>
        <p class="kicker">The challenge</p>
        {project.problem.map((p) => <p>{p}</p>)}
      </article>
      <article>
        <p class="kicker">Our approach</p>
        <ul class="approach">
          {project.approach.map((a) => <li>{a}</li>)}
        </ul>
      </article>
    </div>
  </section>

  <!-- Activities -->
  <section class="section section--alt">
    <div class="container">
      <SectionHeading kicker="What we do" title="Activities and initiatives" />
      <div class="activities">
        {project.activities.map((a) => (
          <article class="activity">
            <h3>{a.title}</h3>
            <p>{a.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  {
    project.outcomes.length > 0 && (
      <section class="section">
        <div class="container">
          <SectionHeading
            kicker="Impact"
            title="Outcomes so far — as reported by the chapter"
            lede="We list only outcomes the chapter has publicly reported. Nothing here is estimated or projected."
          />
          <div class="outcomes">
            {project.outcomes.map((o) => (
              <article class="outcome">
                <h3>{o.label}</h3>
                <p>{o.detail}</p>
                {o.source && (
                  <a class="text-link" href={o.source} rel="noopener" target="_blank">
                    Source ↗
                  </a>
                )}
              </article>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <!-- Products link -->
  {
    (project.slug === 'kalakaari' || project.slug === 'srijan') && (
      <section class="section section--alt products-band">
        <div class="container products-inner">
          <div>
            <h2>Support this project through its products</h2>
            <p>
              The makers behind {project.name} sell their work through the chapter — every purchase supports them
              directly.
            </p>
            <a class="btn btn--primary" href="/shop?from={'project-' + project.slug}">Browse related products</a>
          </div>
        </div>
      </section>
    )
  }

  <!-- Related stories -->
  {
    relatedStories.length > 0 && (
      <section class="section">
        <div class="container">
          <SectionHeading kicker="Stories" title="Related reading" />
          <div class="related-grid">
            {relatedStories.map((s) => (
              <StoryCard slug={s!.slug} />
            ))}
          </div>
        </div>
      </section>
    )
  }

  <!-- Related projects -->
  {
    relatedProjects.length > 0 && (
      <section class="section section--alt">
        <div class="container">
          <SectionHeading kicker="Keep exploring" title="Other projects" />
          <div class="related-grid">
            {relatedProjects.map((p) => (
              <ProjectCard slug={p!.slug} />
            ))}
          </div>
        </div>
      </section>
    )
  }

  <GetInvolvedCTA
    title={`Get involved with ${project.name}`}
    body="Students, volunteers and partners can all contribute to this project. Reach the team to talk about how you would like to help."
  />
</BaseLayout>

<style>
  .hero {
    padding-block: clamp(2.5rem, 6vw, 4rem) clamp(2rem, 4vw, 3rem);
  }

  .hero h1 {
    max-width: 18ch;
  }

  .section--flush {
    padding-bottom: 0;
  }

  .two-col {
    display: grid;
    gap: clamp(2rem, 5vw, 4.5rem);
  }

  @media (min-width: 900px) {
    .two-col {
      grid-template-columns: 1fr 1fr;
    }
  }

  .two-col .kicker {
    margin-bottom: var(--space-2);
  }

  .approach {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-3);
  }

  .approach li {
    background: var(--tile-surface);
    border: 0;
    border-radius: var(--radius-lg);
    padding: var(--space-4) var(--space-5) var(--space-4) 3rem;
    color: var(--ink-2);
    position: relative;
    box-shadow: inset 0 0 0 1px rgba(32, 32, 32, 0.05);
  }

  .approach li::before {
    content: '→';
    position: absolute;
    left: 1.1rem;
    color: var(--accent);
    font-weight: 700;
  }

  .activities {
    display: grid;
    gap: var(--space-4);
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
  }

  .activity {
    background: var(--tile-surface);
    border: 0;
    border-radius: var(--radius-xl);
    padding: var(--space-5) var(--space-6);
    box-shadow:
      var(--shadow-tile-sm),
      inset 0 1px 0 rgba(255, 255, 255, 0.95),
      inset 0 0 0 1px rgba(32, 32, 32, 0.055);
  }

  .activity h3 {
    font-size: 1.05rem;
    margin-bottom: 0.4rem;
  }

  .activity p {
    color: var(--ink-2);
    font-size: 0.94rem;
    margin: 0;
  }

  .outcomes {
    display: grid;
    gap: var(--space-4);
    max-width: 44rem;
  }

  .outcome {
    background: var(--tile-surface);
    border: 0;
    border-radius: var(--radius-xl);
    padding: var(--space-5) var(--space-6);
    box-shadow:
      var(--shadow-tile-sm),
      inset 0 1px 0 rgba(255, 255, 255, 0.95),
      inset 0 0 0 1px rgba(32, 32, 32, 0.055);
  }

  .outcome h3 {
    font-size: 1.1rem;
    margin-bottom: 0.35rem;
  }

  .outcome p {
    color: var(--ink-2);
    font-size: 0.94rem;
    margin-bottom: 0.5rem;
  }

  .products-band {
    background: var(--dark);
    color: rgba(255, 255, 255, 0.85);
  }

  .products-band h2 {
    color: #fff;
  }

  .products-band p {
    color: rgba(255, 255, 255, 0.7);
    max-width: 38rem;
  }

  .products-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-5);
  }

  .products-inner p {
    margin-bottom: var(--space-5);
  }

  .related-grid {
    display: grid;
    gap: var(--space-5);
    grid-template-columns: 1fr 1fr;
  }

  @media (max-width: 880px) {
    .related-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
